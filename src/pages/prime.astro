    description: 'Materiale extra per chi vuole andare oltre il programma.',
    href: publicMaterialUrl('prime/robot-intro.pdf'),
    date: 'Settembre 2026',
    difficulty: 1,
    tags: ['intro'],
    meta: [
      { label: 'Autore', value: 'Mattia Marini' },
      { label: 'Unità', value: '1' },
    ],
    toc: ['Il robot e le sue istruzioni', 'Algoritmi del robot (percorsi)', 'Accenno a componenti del pc', 'Come legge il codice il pc', 'Accenno a python'],
  },
  {
    title: 'Introduzione a python',
    description: 'Concetti fondamentali per iniziare a scrivere qualche semplice programmino',
    href: 'https://marini-didattica.github.io/slide-prime/1-introduzione-python/',
    date: 'Ottobre 2026',
    difficulty: 1,
    tags: ['intro', 'python'],
    meta: [
      { label: 'Autore', value: 'Mattia Marini' },
      { label: 'Unità', value: '2' },
    ],
    toc: ['Come legge il codice il pc', 'Le regole d\'oro per programmare', 'I blocchi di costruzione di un programma', 'Variabili, liste, if/elif/else e cicli while'],
  },
  {
    title: 'Esercizi introduttivi in python',
    description: 'Una collezione di esercizi introduttivi in python',
    href: 'https://marini-didattica.github.io/slide-prime/2-esercizi-python/',
    date: 'Ottobre 2026',
    difficulty: 2,
    tags: ['esercizi', 'python'],
    meta: [
      { label: 'Autore', value: 'Mattia Marini' },
      { label: 'Unità', value: '2' },
    ],
    toc: [
      'Controlli con if/elif/else',
      'Ripetere operazioni con i cicli while',
      'Scorrere liste con cicli while',
    ],
  },
];

const extra: Slide[] = [
  {
    title: 'Simulazione prova 1',
    description: 'Simulazione di verifica su teoria, scrittura e lettura del codice Python',
    href: publicBrowserUrl('prime/esercitazione-1'),
    date: 'Ottobre 2026',
    tags: ['esercizi', 'verifica', 'python'],
    toc: [
      'Teoria',
      'Scrittura del codice',
      'Lettura del codice',
    ],
  },
  {
    title: 'Cheatsheet python',
    description: 'Collezione di concetti e comandi fondamentali per programmare in python',
    href: publicMaterialUrl('prime/python-intro.pdf'),
    date: 'Ottobre 2026',
    tags: ['cheatsheet', 'intro', 'python'],
    toc: [
    'Variabili',
      'Liste',
      'if/elif/else',
      'Ciclo while',
      'Errori comuni',
      'Pattern ricorrenti',
    ],
  },
  {
    title: 'Uso vscode.dev',
    description: 'Tutorial per usare l\'editor di codice vscode.dev direttamente dal browser',
    href: 'https://marini-didattica.github.io/extra-slides/vscode-web/',
    date: 'Settembre 2026',
    tags: ['guide', 'extra'],
    toc: [
      'Installazione estensioni',
      'Sincronizzazione workspace',
      'Primo programma',
    ],
  },
];
---

<PageLayout
  eyebrow="Materiale didattico"
  title="Classi prime"
  description="Slides, materiali e link dedicati alle classi prime. Clicca una scheda per aprire le slide."
>
  <SlideGrid slides={lessonSlides} />
  <Separator label="Extra" />
  <SlideGrid slides={extra} />
</PageLayout>
