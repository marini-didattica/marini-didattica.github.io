---
import Separator from '@/components/Separator.astro';
import SlideGrid from '@/components/SlideGrid.astro';
import { publicMaterialUrl, publicBrowserUrl } from '@/consts';
import PageLayout from '@/layouts/PageLayout.astro';
import type { Slide } from '@/types';

// One object per slide deck. Duplicate this page for each class/project and
// replace the placeholders below. Remember to add a matching entry to
// SECTIONS in `src/consts.ts`.
// TODO: replace with your own content.
const lessonSlides: Slide[] = [
  {
