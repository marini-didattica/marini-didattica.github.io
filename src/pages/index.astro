---
import Card from '@/components/Card.astro';
import { SITE_DESCRIPTION, SITE_NAME } from '@/consts';
import PageLayout from '@/layouts/PageLayout.astro';
import { withBase } from '@/utils/base';

const siteName = SITE_NAME;
---

<PageLayout title="Tutto il materiale" documentTitle={siteName} description={SITE_DESCRIPTION}>
  <div class="flex flex-wrap gap-6">
    <Card
      href={withBase('/prime')}
      class="min-w-[min(100%,17rem)] grow basis-[17rem]"
    >
      <h2 class="mb-2 text-xl font-bold">Prime</h2>
      <p class="leading-relaxed text-text-secondary">Slide e materiali per le classi prime.</p>
    </Card>

    <Card
      href={withBase('/seconde')}
      class="min-w-[min(100%,17rem)] grow basis-[17rem]"
    >
      <h2 class="mb-2 text-xl font-bold">Seconde</h2>
      <p class="leading-relaxed text-text-secondary">Slide e materiali per le classi seconde.</p>
    </Card>

    <Card
      href={withBase('/olimpiadi')}
      class="min-w-[min(100%,17rem)] grow basis-[17rem]"
    >
      <h2 class="mb-2 text-xl font-bold">Olimpiadi</h2>
      <p class="leading-relaxed text-text-secondary">Slide e materiali per l'allenamento olimpico.</p>
    </Card>
  </div>
</PageLayout>
