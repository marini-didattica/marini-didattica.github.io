---
import Button from '@/components/Button.astro';
import Card from '@/components/Card.astro';
import { RESERVED_CONTENT_URL } from '@/consts';
import PageLayout from '@/layouts/PageLayout.astro';
---

<PageLayout
  title="Area riservata"
  eyebrow="Materiale riservato"
  description="Inserisci il codice fornito in classe per aprire i tuoi materiali."
>
  <div class="grid gap-6 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]">
    <Card>
      <h2 class="mb-2 text-xl font-bold">Accedi ai tuoi materiali</h2>
      <p class="leading-relaxed text-text-secondary">
        Ogni studente riceve un codice personale. Il codice apre una cartella in sola lettura con
        dispense, esercizi e PDF.
      </p>

      <form
        id="reserved-code-form"
        data-base={RESERVED_CONTENT_URL}
        class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-end"
        novalidate
      >
        <div class="flex flex-1 flex-col gap-1">
          <label for="reserved-code" class="text-sm font-semibold">Codice</label>
          <input
            type="text"
            id="reserved-code"
            name="code"
            required
            autocomplete="off"
            autocapitalize="characters"
            spellcheck="false"
            maxlength="12"
            placeholder="H234HUA6"
            aria-describedby="reserved-code-error"
            class="w-full rounded-md border border-border bg-surface px-3 py-2.5 uppercase text-text transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/15"
          />
          <p id="reserved-code-error" class="hidden text-xs text-error" role="alert">
            Inserisci un codice valido.
          </p>
        </div>

        <Button type="submit">Apri materiale</Button>
      </form>

      <p class="mt-4 text-xs text-text-secondary">
        I materiali sono in sola lettura: puoi consultarli e scaricarli, ma non modificarli.
      </p>
    </Card>

    <Card>
      <h2 class="mb-3 text-xl font-bold">Come funziona</h2>
      <ol class="m-0 flex list-decimal flex-col gap-3 pl-5 leading-relaxed text-text-secondary">
        <li>Ricevi il codice dal docente.</li>
        <li>Inseriscilo qui sopra e apri la tua cartella.</li>
        <li>Naviga le sottocartelle e apri i file che ti servono.</li>
      </ol>
    </Card>
  </div>
</PageLayout>

<script>
  // Runs on the initial load and after every ClientRouter navigation.
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('reserved-code-form');
    const input = document.getElementById('reserved-code');
    const error = document.getElementById('reserved-code-error');

    if (
      form instanceof HTMLFormElement &&
      input instanceof HTMLInputElement &&
      error instanceof HTMLElement
    ) {
      const base = form.dataset.base ?? 'https://marini-didattica.github.io/materiale/private/';
      // Keep in sync with `CODE_PATTERN` in materiale/scripts/build-content.ts.
      const codePattern = /^[A-Z0-9]{8}$/;

      try {
        const saved = localStorage.getItem('riservato-code');

        if (saved && !input.value) {
          input.value = saved;
        }
      } catch {
        // Ignore storage failures in restricted browsing contexts.
      }

      form.addEventListener('submit', (event) => {
        event.preventDefault();

        const code = input.value
          .trim()
          .toUpperCase()
          .replace(/[^A-Z0-9]/g, '');

        input.value = code;

        if (!codePattern.test(code)) {
          error.classList.remove('hidden');
          input.setAttribute('aria-invalid', 'true');
          input.focus();
          return;
        }

        error.classList.add('hidden');
        input.removeAttribute('aria-invalid');

        try {
          localStorage.setItem('riservato-code', code);
        } catch {
          // Ignore storage failures in restricted browsing contexts.
        }

        window.location.assign(`${base}${code}/`);
      });

      input.addEventListener('input', () => {
        if (!error.classList.contains('hidden')) {
          error.classList.add('hidden');
          input.removeAttribute('aria-invalid');
        }
      });
    }
  });
</script>
