---
import Separator from '@/components/Separator.astro';
import SlideGrid from '@/components/SlideGrid.astro';
import { publicMaterialUrl, publicBrowserUrl } from '@/consts';
import PageLayout from '@/layouts/PageLayout.astro';
import type { Slide } from '@/types';

const lessonSlides: Slide[] = [
  {
    title: 'Ripasso Python',
    description:
      'Ripasso dei concetti fondamentali di Python',
    href: 'https://slides.didattica.mattia-marini.com/seconde/1-introduzione-python/',
    date: 'Settembre 2026',
    difficulty: 2,
    tags: ['ripasso', 'python'],
    meta: [
      { label: 'Autore', value: 'Mattia Marini' },
      { label: 'Unità', value: '1' },
    ],
    toc: [
      'Variabili e tipi',
      'Operatori aritmetici, di confronto e logici',
      'Condizioni if / elif / else',
      'Cicli for e while',
      'Stringhe',
      'Liste',
      'Esercizi',
    ],
  },
  {
    title: 'Esercizi Python',
    description: 'Raccolta di esercizi con liste e stringhe in Python.',
    href: 'https://slides.didattica.mattia-marini.com/seconde/2-esercizi-python/',
    date: 'Ottobre 2026',
    difficulty: 3,
    tags: ['esercizi', 'python', 'liste', 'stringhe'],
    meta: [
      { label: 'Autore', value: 'Mattia Marini' },
      { label: 'Unità', value: '2' },
    ],
    toc: ['Raggruppamento anagrammi', 'Battaglia navale', 'ASCII art'],
  },
  {
    title: 'Python idiomatico',
    description:
      'Dalla sintassi essenziale alle soluzioni idiomatiche: for each, enumerate, sorted, f-string e slicing.',
    href: 'https://slides.didattica.mattia-marini.com/seconde/3-python-idiomatico/',
    date: 'Novembre 2026',
    difficulty: 3,
    tags: ['python', 'buone pratiche', 'liste', 'stringhe'],
    meta: [
      { label: 'Autore', value: 'Mattia Marini' },
      { label: 'Unità', value: '3' },
    ],
    toc: [
      'For each e operatore in',
      'enumerate',
      'sorted, min e max',
      'f-string',
      'Slicing e indici negativi',
      'Riepilogo ed esercizi',
    ],
  },
  {
    title: 'Funzioni in Python',
    description:
      'Definire e usare funzioni: parametri, argomenti, return, scope e annotazioni di tipo.',
    href: 'https://slides.didattica.mattia-marini.com/seconde/4-funzioni-python/',
    date: 'Novembre 2026',
    difficulty: 3,
    tags: ['python', 'funzioni', 'buone pratiche'],
    meta: [
      { label: 'Autore', value: 'Mattia Marini' },
      { label: 'Unità', value: '4' },
    ],
    toc: [
      'Input → funzione → output',
      'Definire e chiamare una funzione',
      'Parametri, argomenti e default',
      'return, None e scope',
      'Annotazioni di tipo',
      'Riepilogo ed esercizi',
    ],
  },
  {
    title: 'Esercizi avanzati',
    description:
      'Un programma completo: simulazione di una battaglia Pokémon con generazione casuale, turni e barre della vita in ASCII.',
    href: 'https://slides.didattica.mattia-marini.com/seconde/5-esercizi-avanzati/',
    date: 'Novembre 2026',
    difficulty: 4,
    tags: ['python', 'esercizi', 'liste', 'funzioni', 'random'],
    meta: [
      { label: 'Autore', value: 'Mattia Marini' },
      { label: 'Unità', value: '5' },
    ],
    toc: [
      'Pokémon battle',
      'Dati senza classi',
      'Generazione casuale',
      'Formule di danno',
      'Barre HP in ASCII',
      'Codice completo',
    ],
  },
];

const extra: Slide[] = [
  {
    title: 'Simulazione prova 1',
    description: 'Simulazione di verifica su produzione e lettura di codice con liste in Python',
    href: publicBrowserUrl('seconde/esercitazione-1'),
    date: 'Ottobre 2026',
    tags: ['esercizi', 'verifica', 'python'],
    toc: [
      'Produzione del codice',
      'Lettura del codice',
    ],
  },
  {
    title: 'Cheatsheet python',
    description:
      'Collezione di concetti e comandi fondamentali su liste e ciclo for in python',
    href: publicMaterialUrl('seconde/cheatsheet.pdf'),
    date: 'Ottobre 2026',
    tags: ['cheatsheet', 'python'],
    toc: [
      'Liste',
      'Ciclo for',
      'Esempi ultra comuni',
      'Errori ultra comuni',
    ],
  },
  {
    title: 'Uso vscode.dev',
    description: 'Tutorial per usare l\'editor di codice vscode.dev direttamente dal browser',
    href: 'https://slides.didattica.mattia-marini.com/extra/vscode-web/',
    date: 'Settembre 2026',
    tags: ['guide', 'extra'],
    toc: [
      'Installazione estensioni',
      'Sincronizzazione workspace',
      'Primo programma',
    ],
  },
];
---

<PageLayout
  eyebrow="Materiale didattico"
  title="Classi seconde"
  description="Slides, materiali e link dedicati alle classi seconde. Clicca una scheda per aprire le slide."
>
  <SlideGrid slides={lessonSlides} />
  <Separator label="Extra" />
  <SlideGrid slides={extra} />
</PageLayout>
