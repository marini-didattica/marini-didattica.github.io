---
import MobileNav from '@/components/MobileNav.svelte';
import { base, isExternalHref } from '../utils/base';

export interface NavLink {
  href: string;
  label: string;
}

export interface Props {
  siteName: string;
  links?: NavLink[];
  /** Optional entry pinned to the far right of the bar. */
  action?: NavLink;
}

const { siteName, links = [], action } = Astro.props;
const currentPath = Astro.url.pathname;
const actionIsExternal = action ? isExternalHref(action.href) : false;

function normalizePath(path: string): string {
  if (path === '/') return '/';
  return path.endsWith('/') ? path.slice(0, -1) : path;
}
---

<header class="sticky top-0 z-[var(--z-sticky)] h-[var(--nav-height)] border-b border-border bg-[var(--color-surface)] backdrop-blur-[12px]">
<nav aria-label="Main navigation" class="h-full">
  <div class="relative mx-auto flex h-full max-w-[72rem] items-center px-[var(--space-lg)]">
    <a href={base} class="text-lg font-bold text-text no-underline">{siteName}</a>

    {links.length > 0 && (
      <ul class="absolute inset-x-0 hidden justify-center gap-[var(--space-md)] list-none p-0 pointer-events-none md:flex" role="list">
        {links.map((link) => (
          <li class="pointer-events-auto">
            <a
              href={link.href}
              class:list={[
                'text-sm font-medium text-text-secondary no-underline px-3 py-1.5 rounded-[var(--radius-lg)] transition-all duration-200 ease-[cubic-bezier(0.4,0,0.2,1)] hover:text-text hover:bg-bg-secondary hover:shadow-(--shadow-sm)',
                {
                  'text-text bg-bg-secondary shadow-(--shadow-sm)':
                    normalizePath(currentPath) === normalizePath(link.href),
                },
              ]}
              aria-current={
                normalizePath(currentPath) === normalizePath(link.href) ? 'page' : undefined
              }
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )}

    <div class="ml-auto flex items-center gap-[var(--space-sm)]">
      <slot />
      {action && (
        <a
          href={action.href}
          target={actionIsExternal ? '_blank' : undefined}
          rel={actionIsExternal ? 'noopener noreferrer' : undefined}
          data-astro-reload={actionIsExternal || undefined}
          aria-label={action.label}
          title={action.label}
          class="hidden items-center gap-1.5 rounded-[var(--radius-lg)] border border-accent/30 bg-accent/10 px-2.5 py-1.5 text-sm font-semibold text-accent no-underline transition-colors hover:bg-accent/15 hover:text-accent-hover md:inline-flex"
        >
          <span class="hidden lg:inline">{action.label}</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-4 w-4 shrink-0"
            aria-hidden="true"
          >
            <path d="M7 17 17 7"></path>
            <path d="M7 7h10v10"></path>
          </svg>
        </a>
      )}
      {links.length > 0 && (
        <MobileNav
          client:media="(max-width: 767.98px)"
          links={links}
          currentPath={currentPath}
          action={action}
        />
      )}
    </div>
  </div>
</nav>
</header>
