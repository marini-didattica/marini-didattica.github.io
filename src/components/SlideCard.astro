---
import type { Slide } from '../types';
import { isExternalHref } from '../utils/base';
import { cn } from '../utils/cn';
import Tag from './Tag.astro';
import TocPreview from './TocPreview.svelte';

export interface Props extends Slide {
  class?: string;
}

const {
  title,
  href,
  description,
  date,
  tags = [],
  meta = [],
  difficulty,
  toc = [],
  class: className,
} = Astro.props;

const rating =
  typeof difficulty === 'number' ? Math.min(5, Math.max(0, Math.round(difficulty))) : undefined;
const hasFooter = rating !== undefined || tags.length > 0 || Boolean(date);
---

<article
  class={cn(
    'group relative flex h-full flex-col rounded-xl border border-border bg-surface p-6 transition-all',
    'hover:border-accent hover:shadow-(--shadow-md) focus-within:shadow-(--shadow-md)',
    className,
  )}
>
  <div class="flex items-start justify-between gap-3">
    <h2 class="text-lg font-bold text-text">
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        data-astro-reload={isExternalHref(href) || undefined}
        class="text-inherit no-underline transition-colors after:absolute after:inset-0 after:content-[''] group-hover:text-accent"
      >
        {title}
      </a>
    </h2>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="mt-1 h-4 w-4 shrink-0 text-text-secondary transition-colors group-hover:text-accent"
      aria-hidden="true"
    >
      <path d="M7 17 17 7"></path>
      <path d="M7 7h10v10"></path>
    </svg>
  </div>

  {description && <p class="mt-2 text-sm leading-relaxed text-text-secondary">{description}</p>}

  {meta.length > 0 && (
    <dl class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-text-secondary">
      {meta.map(({ label, value }) => (
        <div class="flex gap-1">
          <dt class="font-medium">{label}:</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
  )}

  {toc.length > 0 && <TocPreview items={toc} client:load />}

  {hasFooter && (
    <footer class="mt-auto flex items-end justify-between gap-4 pt-4">
      <div class="flex flex-col gap-1">
        {rating !== undefined && (
          <div
            class="flex items-center gap-0.5"
            role="img"
            aria-label={`Difficoltà ${rating} su 5`}
          >
            {[1, 2, 3, 4, 5].map((star) => (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill={star <= rating ? 'currentColor' : 'none'}
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class={cn(
                  'h-4 w-4',
                  star <= rating ? 'text-warning' : 'text-text-secondary',
                )}
                aria-hidden="true"
              >
                <path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.771-.56l.882-5.14a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path>
              </svg>
            ))}
          </div>
        )}
        {date && <time class="text-xs text-text-secondary" datetime={date}>{date}</time>}
      </div>

      {tags.length > 0 && (
        <ul class="flex flex-wrap justify-end gap-2">
          {tags.map((tag) => (
            <li>
              <Tag>{tag}</Tag>
            </li>
          ))}
        </ul>
      )}
    </footer>
  )}
</article>
